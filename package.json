{
    "name": "teleproto",
    "version": "1.229.1",
    "description": "Modern Telegram MTProto client for Node.js, written in TypeScript",
    "main": "index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        },
        "./client": {
            "types": "./client/index.d.ts",
            "default": "./client/index.js"
        },
        "./client/updates": {
            "types": "./client/updates/index.d.ts",
            "default": "./client/updates/index.js"
        },
        "./errors": {
            "types": "./errors/index.d.ts",
            "default": "./errors/index.js"
        },
        "./events": {
            "types": "./events/index.d.ts",
            "default": "./events/index.js"
        },
        "./extensions": {
            "types": "./extensions/index.d.ts",
            "default": "./extensions/index.js"
        },
        "./network": {
            "types": "./network/index.d.ts",
            "default": "./network/index.js"
        },
        "./network/connection": {
            "types": "./network/connection/index.d.ts",
            "default": "./network/connection/index.js"
        },
        "./sessions": {
            "types": "./sessions/index.d.ts",
            "default": "./sessions/index.js"
        },
        "./tl": {
            "types": "./tl/index.d.ts",
            "default": "./tl/index.js"
        },
        "./tl/core": {
            "types": "./tl/core/index.d.ts",
            "default": "./tl/core/index.js"
        },
        "./tl/custom": {
            "types": "./tl/custom/index.d.ts",
            "default": "./tl/custom/index.js"
        },
        "./package.json": "./package.json",
        "./README.md": "./README.md",
        "./LICENSE": "./LICENSE",
        "./*.js": "./*.js",
        "./*.json": "./*.json",
        "./*.ts": "./*.ts",
        "./*": {
            "types": "./*.d.ts",
            "default": "./*.js"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanyok12345/teleproto.git"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc -p tsconfig.json && cp teleproto/tl/generated/api.js dist/tl/generated/api.js && cp teleproto/tl/generated/api.d.ts dist/tl/generated/api.d.ts",
        "typecheck": "tsc --noEmit",
        "generate:tl": "ts-node --transpile-only teleproto_generator/generate.ts",
        "generate:errors": "ts-node --transpile-only teleproto_generator/generate-errors.ts",
        "generate:docs": "ts-node --transpile-only teleproto_generator/harvest-docs.ts",
        "generate": "npm run generate:tl && npm run generate:errors",
        "publish:dist-manifest": "node -e \"const fs=require('fs');const pkg=require('./package.json');const out={name:pkg.name,version:pkg.version,description:pkg.description,main:pkg.main,types:pkg.types,exports:pkg.exports,repository:pkg.repository,license:pkg.license,bugs:pkg.bugs,keywords:pkg.keywords,homepage:pkg.homepage,funding:pkg.funding,engines:pkg.engines,dependencies:pkg.dependencies};fs.writeFileSync('dist/package.json',JSON.stringify(out,null,2)+'\\n');\"",
        "publish:prepare": "npm run clean && npm run generate:tl && npm run generate:errors && npm run build && npm run typecheck && npm run publish:dist-manifest && cp README.md LICENSE dist/ && cp teleproto/define.d.ts dist/define.d.ts && cp teleproto/tl/generated/api.js dist/tl/generated/api.js && cp teleproto/tl/generated/api.d.ts dist/tl/generated/api.d.ts && rm -f dist/tsconfig.tsbuildinfo",
        "publish:check": "npm run publish:prepare && npm pack ./dist --dry-run",
        "publish:latest": "npm run publish:prepare && npm publish ./dist --tag latest",
        "publishOnly": "npm run publish:latest",
        "docs": "typedoc"
    },
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "bugs": {
        "url": "https://github.com/sanyok12345/teleproto/issues"
    },
    "keywords": [
        "telegram",
        "telegram-client",
        "telegram-api",
        "mtproto",
        "userbot",
        "typescript",
        "nodejs",
        "gramjs",
        "gramjs-alternative",
        "api",
        "client",
        "bot",
        "library"
    ],
    "homepage": "https://docs.teleproto.dev",
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/sanyok12345"
    },
    "devDependencies": {
        "@types/mime": "^2.0.3",
        "@types/node": "^22.15.18",
        "@types/node-localstorage": "^1.3.0",
        "ts-node": "^9.1.1",
        "typedoc": "^0.28.7",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "big-integer": "^1.6.48",
        "cifrante": "0.5.1",
        "mime": "^3.0.0",
        "node-localstorage": "^2.2.1",
        "socks": "^2.6.2",
        "store2": "^2.13.0"
    }
}
