{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "rootDir": "./teleproto",
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "strict": true
  },
  "include": ["teleproto"],
  "exclude": ["teleproto/tl/generated/api.js"]
}
